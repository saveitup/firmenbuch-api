{
  "name": "kontur",
  "version": "0.2.0",
  "private": true,
  "description": "Europäische Firmendatenbank — Multi-Country-Lookup über freie Register-APIs.",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "eval:fr": "node scripts/fr-eval.mjs",
    "prewarm:fr": "node --env-file=.env scripts/prewarm-fr.mjs",
    "ingest:fr-sftp": "node --env-file=.env.local scripts/ingest-fr-sftp.mjs",
    "ingest:uk-bulk": "node scripts/ingest-uk-bulk.mjs",
    "ingest:at-universe": "node --env-file=.env scripts/at-universe.mjs",
    "ingest:at-jab": "node --env-file=.env scripts/at-jab-ingest.mjs",
    "eval:new": "node --env-file-if-exists=.env scripts/eval-new-adapters.mjs",
    "check:jab": "node scripts/check-jab-parser.mjs && node scripts/check-financials-store.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.1",
    "pdf-parse": "^2.4.5",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18"
  }
}
