# HMAC secret for signing session cookies. Any long random string.
KONTUR_SECRET=change-me-to-a-long-random-string

# Set to 1 when running behind HTTPS so Secure cookies are emitted.
# KONTUR_SECURE=1

# France — INPI RNE (https://data.inpi.fr). Free account required.
# INPI_USERNAME=you@example.com
# INPI_PASSWORD=

# Austria — JustizOnline IWG token (reserved for the upcoming real AT adapter).
# FIRMENBUCH_TOKEN=
