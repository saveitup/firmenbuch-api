# HMAC secret for signing session cookies. Any long random string.
KONTUR_SECRET=change-me-to-a-long-random-string

# Set to 1 when running behind HTTPS so Secure cookies are emitted.
# KONTUR_SECURE=1

# France — INPI RNE (https://data.inpi.fr). Free account required.
# INPI_USERNAME=you@example.com
# INPI_PASSWORD=

# United Kingdom — Companies House REST API. Register + create a Live
# application at https://developer.company-information.service.gov.uk/
# (REST key type). No approval needed; rate limit is 600 req / 5 min.
# UK_CH_API_KEY=

# Austria — JustizOnline IWG token (reserved for the upcoming real AT adapter).
# FIRMENBUCH_TOKEN=

# Denmark — CVR via Datafordeler distribution. Free webuser account at
# https://datafordeler.dk/ (Selvbetjening → create webuser). One credential
# pair grants access to cvr-permanent and offentliggoerelser indexes.
# DK_CVR_USERNAME=
# DK_CVR_PASSWORD=

# Slovakia (RUZ) and Estonia (RIK) need no credentials — fully public.

# Luxembourg — LBR has no free REST API; all documents are paywalled
# (~5 EUR each) through the LBR web portal. Not implemented; would
# require a LBR-Data commercial contract.

# Slovenia (AJPES) — no public JSON API. Stammdaten come from the monthly
# PRS bulk ZIP; annual reports only via JOLP HTML (AOP row scrape). The
# si adapter is a stub until a bulk ingest + JOLP scraper are wired up.
